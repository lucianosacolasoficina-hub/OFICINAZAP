# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA (https://console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Modelo usado pela IA de atendimento (opcional)
AI_MODEL=claude-opus-5-5
# Quanto esperar (ms) o cliente terminar de mandar mensagens antes de a IA responder
AI_DEBOUNCE_MS=4000

# Qual conexão de WhatsApp usar: "evolution" (QR Code, não oficial) ou "meta" (API oficial)
WHATSAPP_PROVIDER=evolution

# Segredo que vai na URL do webhook da Evolution: .../api/webhooks/whatsapp?token=ESTE_VALOR
WEBHOOK_SECRET=troque-por-um-texto-longo-e-aleatorio

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=oficina

# API oficial da Meta (para quando migrar)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
